# FireShield Non-Secret AWS Environment Configuration Template (.env.example)
# IMPORTANT:
# 1. Copy to .env for local configuration ONLY. Never commit .env to version control.
# 2. Do NOT place AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in .env files.
#    Authenticate via AWS IAM Identity Center (AWS CLI SSO: `aws sso login --profile <profile>`)
#    or an assumed IAM execution role.

# Optional AWS CLI named profile for local SSO authentication
AWS_PROFILE=<YOUR_AWS_SSO_PROFILE_NAME>

# Target AWS Region
FIRESHIELD_AWS_REGION=<YOUR_AWS_REGION_E_G_US_EAST_1>

# Amazon S3 Authorized Media & Sidecar Origin Bucket
FIRESHIELD_S3_MEDIA_BUCKET=<YOUR_FIRESHIELD_MEDIA_S3_BUCKET_NAME>
FIRESHIELD_S3_INPUT_PREFIX=ingest/mezzanine/
FIRESHIELD_S3_OUTPUT_PREFIX=published/renditions/

# AWS Step Functions Release Gate State Machine ARN
FIRESHIELD_STATE_MACHINE_ARN=arn:aws:states:<REGION>:<ACCOUNT_ID>:stateMachine:FireShield-ReleaseGate

# AWS Batch Container Screening Queue & Job Definition ARNs
FIRESHIELD_BATCH_JOB_QUEUE_ARN=arn:aws:batch:<REGION>:<ACCOUNT_ID>:job-queue/FireShield-ScreeningQueue
FIRESHIELD_BATCH_JOB_DEFINITION_ARN=arn:aws:batch:<REGION>:<ACCOUNT_ID>:job-definition/FireShield-ScreeningWorker:1

# Amazon DynamoDB Idempotency & Asset Contract Lock Table
FIRESHIELD_DYNAMODB_CONTRACTS_TABLE=FireShield-AssetContracts

# AWS Elemental MediaConvert Execution Role & Account-Specific Endpoint
FIRESHIELD_MEDIACONVERT_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/FireShield-MediaConvertExecutionRole
FIRESHIELD_MEDIACONVERT_ENDPOINT_URL=https://<ENDPOINT_ID>.mediaconvert.<REGION>.amazonaws.com

# Publisher Ed25519 / KMS Signing Key Identifier (Public Key ID bound in v2 sidecar)
FIRESHIELD_SIGNING_KEY_ID=pub-01-ed25519-2026-q3
FIRESHIELD_KMS_KEY_ARN=arn:aws:kms:<REGION>:<ACCOUNT_ID>:key/<KMS_KEY_UUID>

# Amazon CloudFront Distribution Base URL for Renditions & Sidecars
FIRESHIELD_CLOUDFRONT_BASE_URL=https://<DISTRIBUTION_ID>.cloudfront.net
